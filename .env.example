NODE_ENV=development
# Hanya development; production selalu mewajibkan ganti password pertama.
DEV_SKIP_PASSWORD_CHANGE=false
HOST=127.0.0.1
PORT=3000
# Produksi: HTTPS wajib. Isi loopback hanya jika reverse proxy lokal dipercaya.
TRUST_PROXY=
SESSION_SECRET=
PUBLIC_DASHBOARD=true
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=satu_data_itpln_dev
# Credential pemilik hanya untuk migration/seed/maintenance dan setup tes.
PGUSER=itpln
PGPASSWORD=
# Runtime HTTP selalu memakai role terbatas ini; password minimal 16 karakter.
APP_DB_USER=app_user
APP_DB_PASSWORD=
# Alternatif Docker Compose: ubah PGPORT=5433 dan samakan credential owner di bawah.
POSTGRES_DB=satu_data_itpln_dev
POSTGRES_USER=itpln
POSTGRES_PASSWORD=
# Isi password demo sendiri (minimal 12 karakter); seed tidak mereset user existing.
DEMO_PASSWORD_ADMIN=
DEMO_PASSWORD_VIEWER=
DEMO_PASSWORD_BAA=
DEMO_PASSWORD_PPA=
DEMO_PASSWORD_BSDM=
DEMO_PASSWORD_BPKA=
DEMO_PASSWORD_BKU=
DEMO_PASSWORD_BKM=
DEMO_PASSWORD_LPPM=
DEMO_PASSWORD_PJM=
DEMO_PASSWORD_PRP=
# Untuk db:verify dan npm test: database TERPISAH, nama harus berakhiran _test.
PGTEST_DATABASE=satu_data_itpln_test
